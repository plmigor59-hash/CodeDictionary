<Window x:Class="CodeDictionary.CategoryInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Новая категория"
        WindowStyle="None"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Margin="10"
            Background="{DynamicResource SurfaceBackground}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptTextBlock"
                       Grid.Row="0"
                       Text="Введите название категории:"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <TextBox x:Name="CategoryNameTextBox"
                     Grid.Row="1"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,20"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource ModernButton}"
                        Width="90"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Content="ОК"
                        Style="{StaticResource AccentButton}"
                        Width="90"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
