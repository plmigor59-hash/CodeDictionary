<Window x:Class="CodeDictionary.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка горячих клавиш"
        Width="600" Height="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Нажмите на сочетание клавиш, чтобы изменить его" 
                   Margin="0,0,0,8" 
                   FontSize="13" 
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <ListView x:Name="HotkeyList" 
                  Grid.Row="1"
                  BorderThickness="1"
                  Foreground="{DynamicResource DictTextPrimary}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource SurfaceBackground}"
                  SelectionMode="Single"
                  MouseDoubleClick="HotkeyList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Действие" Width="280" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Сочетание" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CurrentGesture}" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ResetButton" 
                    Content="Сбросить всё" 
                    Click="ResetButton_Click"
                    Margin="0,0,8,0"
                    Padding="10,4"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="1"/>
            <Button x:Name="CloseButton" 
                    Content="Закрыть" 
                    Click="CloseButton_Click"
                    Padding="10,4"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
