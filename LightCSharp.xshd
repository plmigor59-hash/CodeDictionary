<SyntaxDefinition name="C#" extensions=".cs"
    xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <!-- Определение цветов -->
  <Color name="Keyword" foreground="Blue" fontWeight="bold" />
  <Color name="Comment" foreground="Green" />
  <Color name="DocComment" foreground="DarkGreen" fontStyle="italic" />
  <Color name="XmlTag" foreground="Brown" fontWeight="bold" />
  <Color name="XmlAttr" foreground="DarkCyan" />
  <Color name="String" foreground="Maroon" />
  <Color name="Interpolated" foreground="DarkOrange" />
  <Color name="Escape" foreground="Red" fontWeight="bold" />
  <Color name="Number" foreground="Purple" />
  <Color name="Attribute" foreground="DarkCyan" />
  <Color name="Type" foreground="Teal" fontWeight="bold" />
  <Color name="Preprocessor" foreground="Gray" fontWeight="bold" />
  <Color name="Operator" foreground="DarkBlue" />

  <!-- Основной набор правил -->
  <RuleSet>
    <!-- Комментарии -->
    <Span color="Comment" start="//" end="\n" />
    <Span color="DocComment" start="///" end="\n" ruleSet="XmlDoc" />
    <Span color="Comment" start="/" end="/" multiline="true" />

    <!-- Строки -->
    <Span color="String" start="&quot;" end="&quot;" ruleSet="StringContent" />
    <Span color="String" start="'" end="'" ruleSet="StringContent" />
    <Span color="String" start="@&quot;" end="&quot;" multiline="true" />
    <Span color="Interpolated" start="$&quot;" end="&quot;" ruleSet="InterpolatedContent" />

    <!-- Атрибуты -->
    <Span color="Attribute" start="[" end="]" />

    <!-- Препроцессор -->
    <Span color="Preprocessor" start="#" end="\n" />

    <!-- Числа -->
    <Rule regex="\b\d+(\.\d+)?\b" color="Number" />

    <!-- Операторы -->
    <Rule regex="\+|\-|\*|\/|%|==|!=|"<=|>=|&&|\|\||\?|:" color="Operator" />

    <!-- Базовые ключевые слова -->
    <Keywords color="Keyword">
      <Word>class</Word>
      <Word>public</Word>
      <Word>private</Word>
      <Word>protected</Word>
      <Word>static</Word>
      <Word>void</Word>
      <Word>int</Word>
      <Word>string</Word>
      <Word>return</Word>
      <Word>new</Word>
      <Word>using</Word>
      <Word>namespace</Word>
      <Word>if</Word>
      <Word>else</Word>
      <Word>for</Word>
      <Word>foreach</Word>
      <Word>while</Word>
      <Word>switch</Word>
      <Word>case</Word>
      <Word>break</Word>
      <Word>continue</Word>
      <Word>true</Word>
      <Word>false</Word>
      <Word>null</Word>
    </Keywords>

    <!-- Типы -->
    <Keywords color="Type">
      <Word>bool</Word>
      <Word>byte</Word>
      <Word>char</Word>
      <Word>decimal</Word>
      <Word>double</Word>
      <Word>float</Word>
      <Word>long</Word>
      <Word>object</Word>
      <Word>short</Word>
      <Word>uint</Word>
      <Word>ulong</Word>
      <Word>ushort</Word>
      <Word>nint</Word>
      <Word>nuint</Word>
      <Word>record</Word>
    </Keywords>

    <!-- LINQ -->
    <Keywords color="Keyword">
      <Word>from</Word>
      <Word>select</Word>
      <Word>where</Word>
      <Word>orderby</Word>
      <Word>group</Word>
      <Word>into</Word>
      <Word>join</Word>
      <Word>on</Word>
      <Word>equals</Word>
    </Keywords>

    <!-- Async/await -->
    <Keywords color="Keyword">
      <Word>async</Word>
      <Word>await</Word>
      <Word>yield</Word>
    </Keywords>
  </RuleSet>

  <!-- XML внутри документационных комментариев -->
  <RuleSet name="XmlDoc">
    <Span color="XmlTag" start="&lt;" end="&gt;">
      <RuleSet>
        <Rule regex="\b\w+(?==)" color="XmlAttr" />
        <Span color="String" start="&quot;" end="&quot;" />
      </RuleSet>
    </Span>
  </RuleSet>

  <!-- Интерполированные строки -->
  <RuleSet name="InterpolatedContent">
    <Span color="Keyword" start="{" end="}" />
    <Rule regex="\\[abfnrtv\\\"']" color="Escape" />
    <Rule regex="\\u[0-9A-Fa-f]{4}" color="Escape" />
    <Rule regex="\\x[0-9A-Fa-f]{2,4}" color="Escape" />
  </RuleSet>

  <!-- Escape-последовательности в обычных строках -->
  <RuleSet name="StringContent">
    <Rule regex="\\[abfnrtv\\\"']" color="Escape" />
    <Rule regex="\\u[0-9A-Fa-f]{4}" color="Escape" />
    <Rule regex="\\x[0-9A-Fa-f]{2,4}" color="Escape" />
  </RuleSet>
</SyntaxDefinition>
