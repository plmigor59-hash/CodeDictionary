<Window
    x:Class="CodeDictionary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CodeDictionary"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Справочник кода"
    Width="800"
    Height="400"
    AllowDrop="True"
    AllowsTransparency="False"
    Background="{DynamicResource WindowBackground}"
    Drop="Window_Drop"
    ResizeMode="CanResizeWithGrip"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="Padding" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <!--  Specialized local styles only  -->
        <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource DictAccent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="border"
                            Margin="0,0,4,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon
                                    x:Name="icon"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    Kind="FileOutline"
                                    Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" ContentSource="Header" />
                                <Button
                                    x:Name="CloseButton"
                                    Width="16"
                                    Height="16"
                                    Margin="4,0,0,0"
                                    Click="CloseTabButton_Click"
                                    Foreground="{DynamicResource DictTextPrimary}"
                                    Content="✕"
                                    FontSize="10"
                                    Style="{StaticResource IconButton}"
                                    Visibility="{Binding IsClosable, Converter={StaticResource BoolToStatusConverter}}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceStrongBackground}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom Title Bar  -->
        <Border
            x:Name="TitleBar"
            Grid.Row="0"
            Background="{DynamicResource SidePanelBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="8,0" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="Orange"
                        Text="📚" />
                    <TextBlock
                        x:Name="WindowTitle"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Справочник кода" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        x:Name="MinimizeButton"
                        Width="32"
                        Height="32"
                        Click="MinimizeButton_Click"
                        Content="─"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource IconButton}" />
                    <Button
                        x:Name="MaximizeButton"
                        Width="32"
                        Height="32"
                        Click="MaximizeButton_Click"
                        Content="□"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource IconButton}" />
                    <Button
                        x:Name="CloseButton"
                        Width="32"
                        Height="32"
                        Click="CloseButton_Click"
                        Content="✕"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource IconButton}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Background" Value="#E81123" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="HelpColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!--  Left Panel  -->
            <Grid
                x:Name="SidePanel"
                Grid.Column="0"
                Background="{DynamicResource SidePanelBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Search and Theme Toggle  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="8"
                  
                    Background="{DynamicResource SidePanelBackground}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Foreground="{DynamicResource DictTextPrimary}"
                            Style="{StaticResource ModernTextBox}"
                            Tag="Поиск..."
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Click="SearchBox_TextChanged_Click"
                            Content="✕"
                            Foreground="{DynamicResource DictTextPrimary}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Очистить поиск" />
                    </Grid>

                    <CheckBox
                        x:Name="ThemeCheckBox"
                        HorizontalAlignment="Right"
                        Checked="ThemeCheckBox_Changed"
                        Content="Светлая тема"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Unchecked="ThemeCheckBox_Changed" />
                </StackPanel>

                <!--  Entries TreeView  -->
                <TreeView
                    x:Name="EntriesTreeView"
                    Grid.Row="1"
                    Margin="8,0"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderThickness="0"
                    DragOver="EntriesTreeView_DragOver"
                    Drop="EntriesTreeView_Drop"
                    MouseDoubleClick="EntriesTreeView_MouseDoubleClick"
                    PreviewMouseLeftButtonDown="EntriesTreeView_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="EntriesTreeView_PreviewMouseMove"
                    SelectedItemChanged="EntriesTreeView_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="AddCategoryRoot_Click" Header="Добавить корневую категорию">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FolderPlusOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Click="DeleteEntry_Click"
                                Foreground="{DynamicResource DangerBrush}"
                                Header="Удалить отмеченные">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Kind="DeleteSweepOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNode}" ItemsSource="{Binding Items}">
                            <StackPanel
                                Margin="0,2"
                                Background="Transparent"
                                Orientation="Horizontal">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="AddCategoryChild_Click"
                                            Header="Добавить подкатегорию"
                                            Tag="{Binding}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="FolderPlus" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="RenameCategory_Click"
                                            Header="Переименовать"
                                            Tag="{Binding}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="PencilOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem
                                            Click="DeleteCategory_Click"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Header="Удалить категорию"
                                            Tag="{Binding}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Kind="FolderRemoveOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <CheckBox
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsChecked}" />
                                <materialIcons:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,4,0"
                                    Foreground="{DynamicResource WarningBrush}"
                                    Kind="Folder" />
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Name}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding CountString}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:CodeEntryViewModel}">
                            <StackPanel
                                Margin="0,2"
                                Background="Transparent"
                                Orientation="Horizontal">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="DeleteSingleEntry_Click"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Header="Удалить запись"
                                            Tag="{Binding}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Kind="FileRemoveOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <CheckBox
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsChecked}" />
                                <materialIcons:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,4,0"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Kind="FileDocumentOutline" />
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!--  Bottom Actions in SidePanel  -->
                <StackPanel Grid.Row="2" Margin="8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Click="AddEntry_Click"
                            Content="+ Новая запись"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Click="DeleteEntry_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Удалить отмеченные">
                            <materialIcons:MaterialIcon Foreground="{DynamicResource DangerBrush}" Kind="DeleteSweep" />
                        </Button>
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Название" />
                    <TextBox
                        x:Name="TitleTextBox"
                        Margin="0,0,0,8"
                        Style="{StaticResource ModernTextBox}" />

                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Категория" />
                    <ComboBox
                        x:Name="CategoryComboBox"
                        Height="28"
                        Margin="0,0,0,8"
                        IsEditable="True" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            Click="SaveEntry_Click"
                            Content="Сохранить"
                            Style="{StaticResource ModernButton}" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Click="DeleteSingleEntry_Click"
                            Content="Удалить"
                            Style="{StaticResource ModernButton}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                Background="{DynamicResource BorderBrush}" />

            <!--  Right Panel (Editor)  -->
            <Grid Grid.Column="2" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DescriptionRow" Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Editor Toolbar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Padding="4"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Click="UndoMenuItem_Click"
                            Content="↩"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Отменить" />
                        <Button
                            Click="RedoMenuItem_Click"
                            Content="↪"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Повторить" />
                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <Button
                            Click="CopyMenuItem_Click"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Копировать">

                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Kind="ContentCopy" />
                        </Button>
                        <Button
                            Click="PasteMenuItem_Click"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Вставить">
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Kind="ContentPaste" />
                        </Button>
                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <ComboBox
                            x:Name="FontFamilyComboBox"
                            Width="120"
                            Height="24"
                            Margin="2,0"
                            FontSize="11"
                            SelectionChanged="FontFamilyComboBox_SelectionChanged" />
                        <ComboBox
                            x:Name="FontSizeComboBox"
                            Width="50"
                            Height="24"
                            Margin="2,0"
                            FontSize="11"
                            SelectionChanged="FontSizeComboBox_SelectionChanged" />

                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <!--  Style Buttons  -->
                        <Button
                            Click="ChangeBackground_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Цвет фона">
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Foreground="{DynamicResource WarningBrush}"
                                Kind="FormatColorFill" />
                        </Button>
                        <Button
                            Click="ChangeForeground_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Цвет текста">
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Foreground="{DynamicResource DangerBrush}"
                                Kind="FormatColorText" />
                        </Button>
                        <Button
                            Click="MakeBold_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Жирный">
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="B" />
                        </Button>
                        <Button
                            Click="MakeItalic_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Курсив">
                            <TextBlock
                                FontStyle="Italic"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="I" />
                        </Button>
                        <Button
                            Click="MakeUnderline_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Подчеркнутый">
                            <TextBlock
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="U"
                                TextDecorations="Underline" />
                        </Button>
                        <Button
                            Click="ClearStyle_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Очистить стиль">
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Foreground="{DynamicResource DangerBrush}"
                                Kind="FormatClear" />
                        </Button>

                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <Button
                            Click="OpenFile_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Открыть файл">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource WarningBrush}"
                                Kind="FolderOpenOutline" />
                        </Button>
                        <Button
                            Click="SaveFile_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Сохранить файл">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource SuccessBrush}"
                                Kind="ContentSaveOutline" />
                        </Button>
                        <Button
                            Click="FormatCode_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Форматировать код">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource AccentBrush}"
                                Kind="FormatIndentIncrease" />
                        </Button>
                        <ToggleButton
                            x:Name="AnalyzeToggle"
                            Click="AnalyzeToggle_Click"
                            Style="{StaticResource IconToggleButton}"
                            ToolTip="Синтаксический анализ">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource DangerBrush}"
                                Kind="TextSearch" />
                        </ToggleButton>

                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <Button
                            Click="ExportData_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Экспорт базы (JSON/XML)">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource AccentBrush}"
                                Kind="DatabaseExportOutline" />
                        </Button>
                        <Button
                            Click="ImportData_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Импорт базы (JSON/XML)">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource AccentBrush}"
                                Kind="DatabaseImportOutline" />
                        </Button>
                        <Button
                            Click="ImportFolder_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Импорт из папки (bsl/html)">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource WarningBrush}"
                                Kind="FolderDownloadOutline" />
                        </Button>
                        <Button
                            Click="ExportSelectedCategory_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Экспорт выбранной категории">
                            <materialIcons:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource SuccessBrush}"
                                Kind="FolderUploadOutline" />
                        </Button>

                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <ComboBox
                            x:Name="SyntaxHighlightingComboBox"
                            Width="140"
                            Height="24"
                            FontSize="11"
                            SelectionChanged="SyntaxHighlightingComboBox_SelectionChanged" />

                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />


                    </WrapPanel>
                </Border>

                <!--  Search In Code Bar & Translator  -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    Padding="4"
                    Background="{DynamicResource SurfaceStrongBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <!--  Search Part  -->
                        <StackPanel Margin="0,0,8,0" Orientation="Horizontal">
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Kind="Magnify" />
                            <TextBox
                                x:Name="SearchInTextBox"
                                Width="180"
                                Background="Transparent"
                                BorderThickness="0"
                                KeyDown="SearchInTextBox_KeyDown"
                                Style="{StaticResource ModernTextBox}"
                                Tag="Найти в коде..."
                                TextChanged="SearchInTextBox_TextChanged" />
                            <Button
                                Click="FindPrevious_Click"
                                Content="▲"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Style="{StaticResource IconButton}"
                                ToolTip="Предыдущее (Shift+F3)" />
                            <Button
                                Click="FindNext_Click"
                                Content="▼"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Style="{StaticResource IconButton}"
                                ToolTip="Следующее (F3)" />
                            <CheckBox
                                x:Name="MatchCaseCheckBox"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Checked="SearchOptions_Changed"
                                Content="Аа"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Unchecked="SearchOptions_Changed" />
                            <TextBlock
                                x:Name="SearchResultsTextBlock"
                                MinWidth="40"
                                Margin="4,0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                VerticalAlignment="Center"
                                FontSize="10"
                                 />
                            <CheckBox
                                x:Name="WordWrapCheckBox"
                                VerticalAlignment="Center"
                                Checked="WordWrapCheckBox_Changed"
                                Content="Перенос"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Unchecked="WordWrapCheckBox_Changed" />
                        </StackPanel>

                        <Separator Margin="4,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <!--  Translator Part  -->
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Перевод:" />
                            <Button
                                Height="24"
                                Margin="2,0"
                                Padding="4,2"
                                Command="{Binding TranslateCommand}"
                                Content="RU"
                                FontSize="10"
                                Style="{StaticResource ModernButton}" />
                            <Button
                                Height="24"
                                Margin="2,0"
                                Padding="4,2"
                                Command="{Binding TranslateToEnglishCommand}"
                                Content="EN"
                                FontSize="10"
                                Style="{StaticResource ModernButton}" />

                            <ComboBox
                                x:Name="LanguageComboBox"
                                Width="110"
                                Height="24"
                                Margin="4,0"
                                DisplayMemberPath="Name"
                                FontSize="10"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage}" />

                            <Button
                                Command="{Binding TranslateToSelectedLanguageCommand}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Style="{StaticResource IconButton}"
                                ToolTip="Перевести на выбранный">
                                <materialIcons:MaterialIcon
                                    Width="14"
                                    Height="14"
                                    Kind="Translate" />
                            </Button>
                            <Button
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="Сбросить перевод">
                                <materialIcons:MaterialIcon
                                    Width="14"
                                    Height="14"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Kind="CloseCircleOutline" />
                            </Button>

                            <TextBlock
                                Margin="8,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="{Binding Status}" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!--  Description Area  -->
                <Grid Grid.Row="2" Margin="0,0,0,8" x:Name="DescriptionPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                        <Button x:Name="EditDescriptionButton" Height="22" Padding="6,0" FontSize="11"
                                Click="EditDescriptionButton_Click"
                                Style="{StaticResource ModernButton}"
                                Content="✏️ Ред." />
                        <Button x:Name="SaveDescriptionButton" Height="22" Padding="6,0" FontSize="11" Margin="4,0,0,0"
                                Click="SaveDescriptionButton_Click" Visibility="Collapsed"
                                Style="{StaticResource ModernButton}"
                                Content="💾 Сохр." />
                    </StackPanel>
                    <wv2:WebView2
                        x:Name="DescriptionBrowser"
                        Grid.Row="1" />
                </Grid>
                <GridSplitter
                    x:Name="DescriptionSplitter"
                    Grid.Row="3"
                    Height="4"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}"
                    Visibility="Collapsed" />

                <!--  Editor Tabs and Editor  -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <TabControl
                        x:Name="EditorTabs"
                        Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="Header"
                        Foreground="Transparent"
                        ItemContainerStyle="{StaticResource EditorTabItemStyle}"
                        SelectionChanged="EditorTabs_SelectionChanged" />

                    <avalonEdit:TextEditor
                        x:Name="CodeTextBox"
                        Grid.Row="1"
                        Background="{DynamicResource WindowBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        FontFamily="Cascadia Mono"
                        FontSize="14"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        HorizontalScrollBarVisibility="Auto"
                        LineNumbersForeground="{DynamicResource TextSecondaryBrush}"
                        ShowLineNumbers="True"
                        VerticalScrollBarVisibility="Auto">
                        <avalonEdit:TextEditor.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="CopyMenuItem_Click" Header="Копировать">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentCopy" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Click="PasteMenuItem_Click" Header="Вставить">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentPaste" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Click="FormatCode_Click" Header="Форматировать">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="CodeBraces" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </avalonEdit:TextEditor.ContextMenu>
                    </avalonEdit:TextEditor>

  
                    <Grid
                        x:Name="ErrorListHeader"
                        Grid.Row="2"
                        Background="{DynamicResource SidePanelBackground}"
                        Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="10,2" Orientation="Horizontal">
                            <materialIcons:MaterialIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,5,0"
                                Foreground="{DynamicResource DangerBrush}"
                                Kind="AlertCircle" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Список ошибок" />
                        </StackPanel>
                        <Button
                            x:Name="CloseErrorListButton"
                            Grid.Column="1"
                            Click="CloseErrorListButton_Click"
                            Foreground="{DynamicResource DictTextPrimary}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Закрыть список">
                            <materialIcons:MaterialIcon
                                Width="14"
                                Height="14"
                                Kind="Close" />
                        </Button>
                    </Grid>

                    <StackPanel
                        x:Name="ErrorListSplitter"
                        Grid.Row="4"
                        Height="8"
                        
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource BorderBrush}"
                        Visibility="Collapsed" />

                    <DataGrid
                        x:Name="ErrorListGrid"
                        Grid.Row="8"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        MouseDoubleClick="ErrorListGrid_MouseDoubleClick"
                        SelectionMode="Single"
                        Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="30" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialIcons:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Kind="AlertCircle" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding Line}"
                                Header="Стр." />
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding Column}"
                                Header="Кол." />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Message}"
                                Header="Описание ошибки">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="5,2" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!--  Bottom Bar: Tags and Description Toggle  -->
                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Теги:" />
                        <TextBox
                            x:Name="TagsTextBox"
                            Width="400"
                            Height="26"
                            Style="{StaticResource ModernTextBox}" />
                    </StackPanel>

                    <Button
                        x:Name="ToggleDescriptionButton"
                        Grid.Column="1"
                        Height="26"
                        Padding="8,2"
                        Click="ToggleDescriptionButton_Click"
                        Content="Описание ▲"
                        Style="{StaticResource ModernButton}" />
                </Grid>
            </Grid>

            <GridSplitter
                x:Name="HelpSplitter"
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Left"
                Background="{DynamicResource BorderBrush}"
                Visibility="Collapsed" />
            <Border
                x:Name="HelpPanel"
                Grid.Column="3"
                Background="{DynamicResource SidePanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WarningBrush}"
                            Text="Горячие клавиши" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Справочная информация по приложению" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                Margin="0,8,0,4"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="Редактор" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="F1" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Esc" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="F3" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Shift+F3" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+S" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+O" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+Z" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+Y" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+G" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Показать/скрыть помощь" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Закрыть помощь" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Найти следующее" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Найти предыдущее" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Сохранить файл" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Открыть файл" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Отменить" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Повторить" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Перейти к строке" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,4"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="Закладки" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Alt+F2" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+Alt+↓" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+Alt+↑" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="F3 (в списке)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Переключить закладку" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Следующая закладка" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Предыдущая закладка" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Список закладок" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,4"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="Интерфейс" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Ctrl+N" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Delete" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Новая запись" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Удалить выбранное" />
                                </StackPanel>
                            </Grid>

                            <!--  Toolbar Section  -->
                            <TextBlock
                                Margin="0,8,0,4"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="Панель инструментов" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource WarningBrush}" Kind="FormatColorFill" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource DangerBrush}" Kind="FormatColorText" />
                                    <TextBlock FontWeight="Bold" Margin="0,2" Foreground="{DynamicResource TextPrimaryBrush}" Text="B" HorizontalAlignment="Center" />
                                    <TextBlock FontStyle="Italic" Margin="0,2" Foreground="{DynamicResource TextPrimaryBrush}" Text="I" HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,2" Foreground="{DynamicResource TextPrimaryBrush}" Text="U" TextDecorations="Underline" HorizontalAlignment="Center" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource DangerBrush}" Kind="FormatClear" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource WarningBrush}" Kind="FolderOpenOutline" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource SuccessBrush}" Kind="ContentSaveOutline" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource AccentBrush}" Kind="FormatIndentIncrease" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource DangerBrush}" Kind="TextSearch" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource AccentBrush}" Kind="DatabaseExportOutline" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource AccentBrush}" Kind="DatabaseImportOutline" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource WarningBrush}" Kind="FolderDownloadOutline" />
                                    <materialIcons:MaterialIcon Width="16" Height="16" Margin="0,2" Foreground="{DynamicResource SuccessBrush}" Kind="FolderUploadOutline" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Цвет фона" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Цвет текста" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Жирный" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Курсив" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Подчеркнутый" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Очистить стиль" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Открыть файл" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Сохранить файл" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Форматировать код" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Синтаксический анализ" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Экспорт базы" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Импорт базы" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Импорт из папки" />
                                    <TextBlock Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="Экспорт категории" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>