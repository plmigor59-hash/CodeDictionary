<Window
    x:Class="CodeDictionary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CodeDictionary"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Справочник кода"
    Width="800"
    Height="400"
    AllowsTransparency="False"
    Background="{DynamicResource WindowBackground}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    AllowDrop="True"
    Drop="Window_Drop"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="8" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="Padding" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <!-- Specialized local styles only -->
        <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon x:Name="icon" Kind="FileOutline" Width="14" Height="14" Margin="0,0,4,0" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                <Button x:Name="CloseButton" 
                                        Style="{StaticResource IconButton}" 
                                        Width="16" Height="16" Margin="4,0,0,0" 
                                        Content="✕" FontSize="10" 
                                        Click="CloseTabButton_Click"
                                        Visibility="{Binding IsClosable, Converter={StaticResource BoolToStatusConverter}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceStrongBackground}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                <Setter TargetName="icon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" 
                Background="{DynamicResource SidePanelBackground}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="8,0">
                    <TextBlock Text="📚" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Orange"/>
                    <TextBlock x:Name="WindowTitle" Text="Справочник кода" 
                               VerticalAlignment="Center" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Content="─" Style="{StaticResource IconButton}" Click="MinimizeButton_Click" Width="32" Height="32"/>
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource IconButton}" Click="MaximizeButton_Click" Width="32" Height="32"/>
                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource IconButton}" Click="CloseButton_Click" Width="32" Height="32">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="HelpColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Grid x:Name="SidePanel" Grid.Column="0" Background="{DynamicResource SidePanelBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search and Theme Toggle -->
                <StackPanel Grid.Row="0" Margin="8" Background="{DynamicResource SidePanelBackground}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" 
                                 Tag="Поиск..." TextChanged="SearchBox_TextChanged" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" 
                                Content="✕" Click="SearchBox_TextChanged_Click" Margin="4,0,0,0" ToolTip="Очистить поиск"/>
                    </Grid>
                    
                    <CheckBox x:Name="ThemeCheckBox" Content="Светлая тема" 
                              HorizontalAlignment="Right"
                              Checked="ThemeCheckBox_Changed" Unchecked="ThemeCheckBox_Changed"
                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Entries TreeView -->
                <TreeView x:Name="EntriesTreeView" Grid.Row="1" Margin="8,0"
                          Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="EntriesTreeView_SelectedItemChanged"
                          MouseDoubleClick="EntriesTreeView_MouseDoubleClick"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="EntriesTreeView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="EntriesTreeView_PreviewMouseMove"
                          DragOver="EntriesTreeView_DragOver"
                          Drop="EntriesTreeView_Drop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Добавить корневую категорию" Click="AddCategoryRoot_Click">
                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="16" Height="16"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Удалить отмеченные" Click="DeleteEntry_Click" Foreground="{DynamicResource DangerBrush}">
                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNode}" ItemsSource="{Binding Items}">
                            <StackPanel Orientation="Horizontal" Margin="0,2" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Добавить подкатегорию" Click="AddCategoryChild_Click" Tag="{Binding}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FolderPlus" Width="16" Height="16"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Переименовать" Click="RenameCategory_Click" Tag="{Binding}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Удалить категорию" Click="DeleteCategory_Click" Tag="{Binding}" Foreground="{DynamicResource DangerBrush}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FolderRemoveOutline" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="Folder" Foreground="{DynamicResource WarningBrush}" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CountString}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:CodeEntryViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="0,2" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Удалить запись" Click="DeleteSingleEntry_Click" Tag="{Binding}" Foreground="{DynamicResource DangerBrush}">
                                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileRemoveOutline" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Foreground="{DynamicResource AccentBrush}" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- Bottom Actions in SidePanel -->
                <StackPanel Grid.Row="2" Margin="8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="+ Новая запись" Style="{StaticResource AccentButton}" Click="AddEntry_Click"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="DeleteEntry_Click" Margin="4,0,0,0" ToolTip="Удалить отмеченные">
                            <materialIcons:MaterialIcon Kind="DeleteSweep" Foreground="{DynamicResource DangerBrush}"/>
                        </Button>
                    </Grid>
                    
                    <TextBlock Text="Название" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox x:Name="TitleTextBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Категория" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CategoryComboBox" IsEditable="True" Height="28" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Сохранить" Style="{StaticResource ModernButton}" Click="SaveEntry_Click" Margin="0,0,4,0"/>
                        <Button Grid.Column="1" Content="Удалить" Style="{StaticResource ModernButton}" Click="DeleteSingleEntry_Click" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" />

            <!-- Right Panel (Editor) -->
            <Grid Grid.Column="2" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DescriptionRow" Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Editor Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,8">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="↩" ToolTip="Отменить" Click="UndoMenuItem_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="↪" ToolTip="Повторить" Click="RedoMenuItem_Click"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                        
                        <Button Style="{StaticResource IconButton}" ToolTip="Копировать" Click="CopyMenuItem_Click">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Вставить" Click="PasteMenuItem_Click">
                            <materialIcons:MaterialIcon Kind="ContentPaste" Width="16" Height="16"/>
                        </Button>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                        <ComboBox x:Name="FontFamilyComboBox" Width="120" Height="24" FontSize="11" Margin="2,0" SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
                        <ComboBox x:Name="FontSizeComboBox" Width="50" Height="24" FontSize="11" Margin="2,0" SelectionChanged="FontSizeComboBox_SelectionChanged"/>
                        
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                        <!-- Style Buttons -->
                        <Button Style="{StaticResource IconButton}" ToolTip="Цвет фона" Click="ChangeBackground_Click">
                            <materialIcons:MaterialIcon Kind="FormatColorFill" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Цвет текста" Click="ChangeForeground_Click">
                            <materialIcons:MaterialIcon Kind="FormatColorText" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Жирный" Click="MakeBold_Click">
                            <TextBlock Text="B" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Курсив" Click="MakeItalic_Click">
                            <TextBlock Text="I" FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Подчеркнутый" Click="MakeUnderline_Click">
                            <TextBlock Text="U" TextDecorations="Underline" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Очистить стиль" Click="ClearStyle_Click">
                            <materialIcons:MaterialIcon Kind="FormatClear" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/>
                        </Button>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                        <Button Style="{StaticResource IconButton}" ToolTip="Открыть файл" Click="OpenFile_Click">
                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Сохранить файл" Click="SaveFile_Click">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Форматировать C#" Click="FormatCSharpCode_Click">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                        <Button Style="{StaticResource IconButton}" ToolTip="Экспорт базы (JSON/XML)" Click="ExportData_Click">
                            <materialIcons:MaterialIcon Kind="DatabaseExportOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Импорт базы (JSON/XML)" Click="ImportData_Click">
                            <materialIcons:MaterialIcon Kind="DatabaseImportOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Импорт из папки (bsl/html)" Click="ImportFolder_Click">
                            <materialIcons:MaterialIcon Kind="FolderDownloadOutline" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Экспорт выбранной категории" Click="ExportSelectedCategory_Click">
                            <materialIcons:MaterialIcon Kind="FolderUploadOutline" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}"/>
                        </Button>
                        
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                        
                        <ComboBox x:Name="SyntaxHighlightingComboBox" Width="140" Height="24" FontSize="11" SelectionChanged="SyntaxHighlightingComboBox_SelectionChanged"/>
                        
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>
                        
                        <CheckBox x:Name="WordWrapCheckBox" Content="Перенос" VerticalAlignment="Center" FontSize="11" 
                                  Checked="WordWrapCheckBox_Changed" Unchecked="WordWrapCheckBox_Changed"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </WrapPanel>
                </Border>

                <!-- Search In Code Bar & Translator -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceStrongBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,8">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Part -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="SearchInTextBox" Width="180" Style="{StaticResource ModernTextBox}" BorderThickness="0" Background="Transparent" Tag="Найти в коде..." TextChanged="SearchInTextBox_TextChanged" KeyDown="SearchInTextBox_KeyDown"/>
                            <Button Style="{StaticResource IconButton}" Content="▲" Click="FindPrevious_Click" ToolTip="Предыдущее (Shift+F3)"/>
                            <Button Style="{StaticResource IconButton}" Content="▼" Click="FindNext_Click" ToolTip="Следующее (F3)"/>
                            <CheckBox x:Name="MatchCaseCheckBox" Content="Аа" VerticalAlignment="Center" Margin="4,0" FontSize="11" Checked="SearchOptions_Changed" Unchecked="SearchOptions_Changed" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="SearchResultsTextBlock" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0" MinWidth="40"/>
                        </StackPanel>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                        <!-- Translator Part -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Перевод:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="4,0"/>
                            <Button Content="RU" Style="{StaticResource ModernButton}" Padding="4,2" FontSize="10" Height="24" Margin="2,0" Command="{Binding TranslateCommand}"/>
                            <Button Content="EN" Style="{StaticResource ModernButton}" Padding="4,2" FontSize="10" Height="24" Margin="2,0" Command="{Binding TranslateToEnglishCommand}"/>
                            
                            <ComboBox x:Name="LanguageComboBox" Width="110" Height="24" FontSize="10" Margin="4,0"
                                      ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"/>
                            
                            <Button Style="{StaticResource IconButton}" ToolTip="Перевести на выбранный" Command="{Binding TranslateToSelectedLanguageCommand}">
                                <materialIcons:MaterialIcon Kind="Translate" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Сбросить перевод" Command="{Binding ClearCommand}">
                                <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}"/>
                            </Button>
                            
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="8,0"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Description Area -->
                <WebBrowser x:Name="DescriptionBrowser" Grid.Row="2" Margin="0,0,0,8" Visibility="Collapsed"/>
                <GridSplitter x:Name="DescriptionSplitter" Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Visibility="Collapsed" Margin="0,0,0,8"/>

                <!-- Editor Tabs and Editor -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TabControl x:Name="EditorTabs" Grid.Row="0" Background="Transparent" BorderThickness="0"
                                ItemContainerStyle="{StaticResource EditorTabItemStyle}"
                                DisplayMemberPath="Header"
                                Foreground="Transparent"
                                SelectionChanged="EditorTabs_SelectionChanged">
                    </TabControl>

                    <avalonEdit:TextEditor x:Name="CodeTextBox" Grid.Row="1"
                                           Background="{DynamicResource WindowBackground}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1"
                                           FontFamily="Consolas" FontSize="12"
                                           ShowLineNumbers="True"
                                           LineNumbersForeground="{DynamicResource TextSecondaryBrush}">
                        <avalonEdit:TextEditor.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать" Click="CopyMenuItem_Click">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Вставить" Click="PasteMenuItem_Click">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentPaste"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Форматировать" Click="FormatCSharpCode_Click">
                                    <MenuItem.Icon><materialIcons:MaterialIcon Kind="CodeBraces"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </avalonEdit:TextEditor.ContextMenu>
                    </avalonEdit:TextEditor>
                </Grid>

                <!-- Bottom Bar: Tags and Description Toggle -->
                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Теги:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="11"/>
                        <TextBox x:Name="TagsTextBox" Style="{StaticResource ModernTextBox}" Width="400" Height="26"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" x:Name="ToggleDescriptionButton" Content="Описание ▲" 
                            Style="{StaticResource ModernButton}" Click="ToggleDescriptionButton_Click" Height="26" Padding="8,2"/>
                </Grid>
            </Grid>

            <GridSplitter x:Name="HelpSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Left" Background="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
            <Border x:Name="HelpPanel" Grid.Column="3" Background="{DynamicResource SidePanelBackground}" Visibility="Collapsed" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Горячие клавиши" Foreground="{DynamicResource WarningBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Справочная информация по приложению" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Редактор" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="F1" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Esc" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="F3" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Shift+F3" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ctrl+S" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ctrl+O" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ctrl+Z" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ctrl+Y" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ctrl+G" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Показать/скрыть помощь" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Закрыть помощь" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Найти следующее" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Найти предыдущее" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Сохранить файл" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Открыть файл" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Отменить" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Повторить" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Перейти к строке" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Закладки" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Alt+F2" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ctrl+Alt+↓" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ctrl+Alt+↑" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="F3 (в списке)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Переключить закладку" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Следующая закладка" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Предыдущая закладка" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Список закладок" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Интерфейс" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Ctrl+N" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Delete" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Новая запись" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Удалить выбранное" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>