<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="WindowBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidePanelColor">#F6F8FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceStrongColor">#F3F3F3</Color>
    <Color x:Key="BorderColor">#D0D7DE</Color>
    <Color x:Key="AccentColor">#0969DA</Color>
    <Color x:Key="AccentHoverColor">#0A7CFB</Color>
    <Color x:Key="TextPrimaryColor">#1F2328</Color>
    <Color x:Key="TextSecondaryColor">#656D76</Color>
    <Color x:Key="SuccessColor">#1A7F37</Color>
    <Color x:Key="DangerColor">#CF222E</Color>
    <Color x:Key="WarningColor">#9A6700</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidePanelBackground" Color="{StaticResource SidePanelColor}"/>
    <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceStrongBackground" Color="{StaticResource SurfaceStrongColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <!-- Legacy mappings for backward compatibility during transition -->
    <SolidColorBrush x:Key="DictSurface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="DictSurfaceStrong" Color="{StaticResource SurfaceStrongColor}" />
    <SolidColorBrush x:Key="DictBorder" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DictCardBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="DictAccent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DictTextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="DictTextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="DarkBackground" Color="{StaticResource WindowBackgroundColor}" />

</ResourceDictionary>