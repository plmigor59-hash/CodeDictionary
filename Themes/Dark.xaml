<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#1E1E1E</Color>
    <Color x:Key="SidePanelColor">#252526</Color>
    <Color x:Key="SurfaceColor">#2D2D2D</Color>
    <Color x:Key="SurfaceStrongColor">#37373D</Color>
    <Color x:Key="BorderColor">#454545</Color>
    <Color x:Key="AccentColor">#007ACC</Color>
    <Color x:Key="AccentHoverColor">#1C97EA</Color>
    <Color x:Key="TextPrimaryColor">#CCCCCC</Color>
    <Color x:Key="TextSecondaryColor">#858585</Color>
    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="DangerColor">#D73A49</Color>
    <Color x:Key="WarningColor">#E3B341</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidePanelBackground" Color="{StaticResource SidePanelColor}" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceStrongBackground" Color="{StaticResource SurfaceStrongColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!--  Legacy mappings for backward compatibility during transition  -->
    <SolidColorBrush x:Key="DictSurface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="DictSurfaceStrong" Color="{StaticResource SurfaceStrongColor}" />
    <SolidColorBrush x:Key="DictBorder" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DictCardBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="DictAccent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DictTextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="DictTextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="DarkBackground" Color="{StaticResource WindowBackgroundColor}" />

</ResourceDictionary>