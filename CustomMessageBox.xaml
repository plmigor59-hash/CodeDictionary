<Window x:Class="CodeDictionary.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение"
        Width="420"
        Height="220"
        MinWidth="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
      
        <SolidColorBrush x:Key="DictSurface" Color="#202A38"/>
        <SolidColorBrush x:Key="DictSurfaceStrong" Color="#273447"/>
        <SolidColorBrush x:Key="DictBorder" Color="#36465E"/>
        <SolidColorBrush x:Key="DictCardBackground" Color="#202A38"/>
        <SolidColorBrush x:Key="DictTitleBackground" Color="#A51A2534"/>
        <SolidColorBrush x:Key="DictStatusBackground" Color="#132f4b"/>
        <SolidColorBrush x:Key="DictAccent" Color="#5BA5FF"/>
        <SolidColorBrush x:Key="DictTextPrimary" Color="#EDF2F7"/>
        <SolidColorBrush x:Key="DictTextSecondary" Color="#A7B3C5"/>
        <SolidColorBrush x:Key="DictSuccess" Color="#4ADE80"/>
        <SolidColorBrush x:Key="DictChat" Color="#FFD700"/>
        <SolidColorBrush x:Key="DarkBackground" Color="#1E1E1E"/>
        
        
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DictAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#8BC3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3F90EB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B9DBFF"/>
                                <Setter Property="Foreground" Value="#0B223C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2E79CF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DictSurfaceStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource DictTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DictBorder}"/>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="{DynamicResource DictSurface}"
            CornerRadius="14"
            BorderBrush="{DynamicResource DictBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#1A000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource DictTitleBackground}"
                    BorderBrush="{DynamicResource DictBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="HeaderDot"
                                   Text="&#x25CF;"
                                   Foreground="{DynamicResource DictAccent}"
                                   FontSize="12"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="TitleText"
                                   Text="Сообщение"
                                   Foreground="{DynamicResource DictTextPrimary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="28"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource DictTextSecondary}"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,18,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        CornerRadius="21"
                        x:Name="IconBackground"
                        Background="#233652"
                        BorderBrush="{DynamicResource DictAccent}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="!"
                               Foreground="{DynamicResource DictChat}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="CaptionText"
                               Text="Требуется подтверждение"
                               Foreground="{DynamicResource DictTextPrimary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource DictTextSecondary}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="18,0,18,18">
                <Button x:Name="CancelButton"
                        Style="{DynamicResource SecondaryDialogButtonStyle}"
                        Margin="0,0,10,0"
                        Content="Отмена"
                        Click="CancelButton_Click"/>
                <Button x:Name="OkButton"
                        Style="{DynamicResource DialogButtonStyle}"
                        Content="OK"
                        Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
